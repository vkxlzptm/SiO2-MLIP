neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

change_box      all x scale ${s} y scale ${s} z scale ${s} remap
change_box      all x scale 1.01961282 y scale ${s} z scale ${s} remap
change_box      all x scale 1.01961282 y scale 1.01961282 z scale ${s} remap
change_box      all x scale 1.01961282 y scale 1.01961282 z scale 1.01961282 remap
