neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

# 등방 스케일 + 원자 좌표 remap (분수좌표 유지)
change_box      all x scale ${s} y scale ${s} z scale ${s} remap
change_box      all x scale 1.00000000 y scale ${s} z scale ${s} remap
change_box      all x scale 1.00000000 y scale 1.00000000 z scale ${s} remap
change_box      all x scale 1.00000000 y scale 1.00000000 z scale 1.00000000 remap
