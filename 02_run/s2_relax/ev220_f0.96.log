neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

change_box      all x scale ${s} y scale ${s} z scale ${s} remap
change_box      all x scale 0.98648483 y scale ${s} z scale ${s} remap
change_box      all x scale 0.98648483 y scale 0.98648483 z scale ${s} remap
change_box      all x scale 0.98648483 y scale 0.98648483 z scale 0.98648483 remap
