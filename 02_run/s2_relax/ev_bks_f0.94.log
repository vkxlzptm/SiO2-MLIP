LAMMPS (2 Aug 2023 - Update 3)
  using 1 OpenMP thread(s) per MPI task
# S2'-3  E-V 스캔 (BKS) — 7net 과 **완전히 동일한 절차**로 K0 를 뽑아 비교한다.
#
# 왜: in.ev220 으로 7net 의 K0 = 43.08 GPa 를 얻었는데 BKS 쪽이 비어 있다.
#     밀도는 3자 비교(7net 2.219 / BKS 2.312 / exp 2.20)인데 탄성률만 7net 단독이라
#     비교가 반쪽이다. BKS 는 초 단위라 안 할 이유가 없다.
#
# 출발: 02_run/s0_requench/sio2_bks220.data (ρ=2.20, 재quench 산물)
#   -var s <선형 스케일> 로 등방 스케일 후 원자만 이완. etol=0, velocity 0.
#   7net 런과 같은 부피점(f = 0.94~1.06)을 쓴다.
#
# 실행: run_ev_bks.sh

units           metal
boundary        p p p
atom_style      charge

read_data       ../s0_requench/sio2_bks220.data
Reading data file ...
  orthogonal box = (-0.13095199 -0.13140962 -0.15165528) to (30.269865 30.375648 35.055481)
  1 by 2 by 3 MPI processor grid
  reading atoms ...
  2160 atoms
  reading velocities ...
  2160 velocities
  read_data CPU = 0.018 seconds
mass            1 15.9994
mass            2 28.0855
# 전하는 data 파일에 포함 (O -1.2, Si +2.4)

pair_style      hybrid/overlay buck/coul/long 10.0 lj/cut 1.5
pair_coeff      1 1 buck/coul/long 1388.7730 0.362318 175.0000
pair_coeff      1 2 buck/coul/long 18003.7572 0.205205 133.5381
pair_coeff      2 2 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 1 lj/cut 3.0 1.50 1.50
pair_coeff      1 2 lj/cut 4.0 1.10 1.10
pair_coeff      2 2 lj/cut 0.0 1.0  1.0
# ★ EOS 용은 1.0e-4 로 부족하다. 2차 스캔에서 모든 최소화가
#   "linesearch alpha is zero" 로 멈췄고 force two-norm 이 0.18~0.36 에서 정체했는데,
#   PPPM 이 보고한 추정 force 오차가 0.0013 eV/A (성분당 RMS 0.0044 와 같은 자릿수)였다.
#   즉 최소화기가 k-space 수치잡음 바닥과 싸우다 멈춘 것. 그 잡음이 E(V) 를 흔들어
#   BM3 잔차 86 meV, BM3 vs virial 0.70 % 불일치를 만들었다 (7net 은 3.1 meV / 0.007 %).
#   → 1.0e-6 으로 조인다. BKS 는 초 단위라 비용 부담 없음.
#   ※ MD 런들은 1.0e-4 그대로 두었다(구조 생성과의 일관성). EOS 전용 설정이다.
kspace_style    pppm 1.0e-6

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

change_box      all x scale ${s} y scale ${s} z scale ${s} remap
change_box      all x scale 0.97958611 y scale ${s} z scale ${s} remap
change_box      all x scale 0.97958611 y scale 0.97958611 z scale ${s} remap
change_box      all x scale 0.97958611 y scale 0.97958611 z scale 0.97958611 remap
Changing box ...
  orthogonal box = (0.17934749 -0.13140962 -0.15165528) to (29.959566 30.375648 35.055481)
  orthogonal box = (0.17934749 0.17997424 -0.15165528) to (29.959566 30.064264 35.055481)
  orthogonal box = (0.17934749 0.17997424 0.20770202) to (29.959566 30.064264 34.696123)

velocity        all set 0.0 0.0 0.0        # Press 를 순수 virial 로 (규칙 6)

variable        epa  equal pe/atoms
variable        dens equal density
variable        fmag atom sqrt(fx*fx+fy*fy+fz*fz)
compute         maxf all reduce max v_fmag

thermo          100
thermo_style    custom step pe v_epa press vol v_dens c_maxf

min_style       cg
min_modify      dmax 0.05
minimize        0.0 1.0e-5 20000 20000     # 잡음 바닥을 낮췄으니 ftol 도 함께 조인다
