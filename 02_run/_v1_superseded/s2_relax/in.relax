units           metal
boundary        p p p
atom_style      charge
read_data       ../../01_input/sio2_quenched.data
mass            1 15.9994
mass            2 28.0855
pair_style      e3gnn
pair_coeff      * * ../../01_input/pot/deployed_nano_4.5.pt O Si
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

variable        epa  equal pe/atoms
variable        dens equal density
variable        fmag atom sqrt(fx*fx+fy*fy+fz*fz)
compute         maxf all reduce max v_fmag

thermo          5
thermo_style    custom step pe v_epa press vol v_dens lx ly lz c_maxf
min_style       cg
min_modify      dmax 0.05

# --- 1단계: 셀 고정, 원자만 이완. SevenNet의 국소 최소로 데려간다 ---
print "=========== STAGE 1: atoms only (cell fixed) ==========="
minimize        1.0e-8 1.0e-2 300 300
write_data      relaxed_s1_atoms.data

# --- 2단계: 셀 + 원자 동시 이완 @ 0 bar. 여기서 밀도가 나온다 ---
print "=========== STAGE 2: box/relax iso 0 bar ==========="
fix             br all box/relax iso 0.0 vmax 0.001
minimize        1.0e-8 1.0e-2 600 600
unfix           br
write_data      relaxed_s2_box.data

# --- 3단계: box/relax 후 원자 재이완 (LAMMPS 권장 절차) ---
print "=========== STAGE 3: atoms again ==========="
minimize        1.0e-8 1.0e-3 200 200
write_data      relaxed_final.data
