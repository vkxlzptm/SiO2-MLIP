# S1-1  BKS 속도 실측 (NVE, 2160 atoms) — SevenNet과 동일한 계, 동일한 초기속도 seed
# BKS는 자기 native 설정(neighbor 2.0, pppm)으로 돌린다: "BKS를 실제로 쓸 때의 비용"이
# 비교 대상이므로 SevenNet 쪽 neighbor 설정을 억지로 맞추지 않는다.
# 실행: Intel MPI launcher로 6랭크 (STATUS 규칙 3, 5)

units           metal
boundary        p p p
atom_style      charge

read_data       ../../01_input/sio2_quenched.data   # q는 data 파일에 이미 있음 (O -1.2, Si +2.4)
mass            1 15.9994
mass            2 28.0855

pair_style      hybrid/overlay buck/coul/long 10.0 lj/cut 1.5
pair_coeff      1 1 buck/coul/long 1388.7730 0.362318 175.0000
pair_coeff      1 2 buck/coul/long 18003.7572 0.205205 133.5381
pair_coeff      2 2 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 1 lj/cut 3.0 1.50 1.50
pair_coeff      1 2 lj/cut 4.0 1.10 1.10
pair_coeff      2 2 lj/cut 0.0 1.0  1.0

kspace_style    pppm 1.0e-4

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.001
velocity        all create 300.0 12345 dist gaussian mom yes
fix             1 all nve

thermo          100
thermo_style    custom step temp pe press

# warm-up (pppm grid 설정 등). 버린다.
run             20

# 측정 구간: BKS는 빠르므로 200 step. atom-step/s로 환산해 비교.
run             200
