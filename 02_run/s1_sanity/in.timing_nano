# S1-1  SevenNet-Nano 속도 실측 (NVE, 2160 atoms)
# 규칙: 단일 랭크 + OMP 스레드 (mpirun 금지, STATUS 규칙 2)
#       실행 전 ulimit -s 262144 (STATUS 규칙 1)

units           metal
boundary        p p p
atom_style      charge          # data 파일이 charge 스타일. e3gnn은 q를 무시함.

read_data       ../../01_input/sio2_quenched.data
mass            1 15.9994       # O
mass            2 28.0855       # Si

pair_style      e3gnn
pair_coeff      * * ../../01_input/pot/deployed_serial.pt O Si   # type1=O, type2=Si (규칙 4)

# skin 1.0 A. neigh_modify check yes 이므로 원자가 0.5 A 이동해야 재빌드.
# 300 K / 20 step(20 fs)에서는 재빌드가 사실상 안 일어남 -> Loop time = 순수 force eval.
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.001
velocity        all create 300.0 12345 dist gaussian mom yes
fix             1 all nve

thermo          10
thermo_style    custom step temp pe press

# --- warm-up: 모델 로드 / 첫 neighbor 빌드 / allocator 워밍업. 이 Loop time은 버린다.
run             3

# --- 측정 구간: 아래 "Loop time" 만 사용
run             20
