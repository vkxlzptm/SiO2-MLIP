# S1-6  cutoff 변종 스윕: 같은 구조에 cutoff만 바꿔 단일점 + 속도를 한 번에 측정
#   -var pot <경로> 로 포텐셜 파일을 주입한다.
#   목적 (a) +9.07 GPa가 cutoff에 robust한지 = 공짜 물리 검증
#        (b) CPU에서 cutoff 축소가 실제로 몇 배인지 = 논문의 GPU 벤치는 우리에게 안 통함
# 실행 전 ulimit -s 262144, OMP_NUM_THREADS=6, mpirun 쓰지 말 것

units           metal
boundary        p p p
atom_style      charge

read_data       ../../01_input/sio2_quenched.data
mass            1 15.9994
mass            2 28.0855

pair_style      e3gnn
pair_coeff      * * ${pot} O Si

neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes

# ---- (a) 단일점: 속도 죽여서 Press = 순수 virial ----
velocity        all set 0.0 0.0 0.0
variable        epa   equal pe/atoms
variable        fmag  atom  sqrt(fx*fx+fy*fy+fz*fz)
compute         maxf  all reduce max v_fmag
thermo_style    custom step temp pe v_epa press c_maxf
thermo          1
run             0

# ---- (b) 속도: NVE, warm-up 3 + 측정 3 ----
velocity        all create 300.0 12345 dist gaussian mom yes
timestep        0.001
fix             1 all nve
thermo          10
run             3
run             3
