# S4  BKS 통제런 — 7net melt-quench와 급랭률·초기구조·셀을 맞춘 대조군
#
# 왜 필요한가:
#   7net 본런은 2×10¹³ K/s로 돌린다. 기존 BKS 220 런(5×10¹² K/s)과 급랭률이 다르므로
#   그대로 비교하면 "위상 차이가 포텐셜 때문인지 급랭률 때문인지" 구분할 수 없다.
#   BKS를 동일 급랭률로 재실행하면 급랭률 아티팩트가 상쇄되고,
#   세 속도를 다 돌리면 급랭률 민감도 자체가 정량화된다 (→ 발표에서 수치로 방어).
#
# 초기구조·셀·앙상블은 7net 본런과 완전히 동일:
#   melt4000.data (ρ = 2.20, V = 32,652.95 Å³) · 전 과정 NVT
#
# 인자:
#   -var ns  <100 K 구간당 step 수>   -var tag <출력 파일 태그>
#     5e12 K/s → ns 20000  (기존 BKS 런과 동일 조건)
#     2e13 K/s → ns  5000  (★ 7net 본런의 짝)
#     5e13 K/s → ns  2000
#
# 비용: 557 step/s (6랭크) 기준 5e12 22분 · 2e13 6분 · 5e13 2분
# 실행: export OMP_NUM_THREADS=1
#       mpirun -np 6 lmp_7net -in in.mqbks -var ns 5000 -var tag 2e13 > mqbks_2e13.log 2>&1
#       ※ 7net 본런과 동시에 돌리지 말 것 (메모리 대역폭 포화)

variable        ns   index 5000
variable        tag  index 2e13

units           metal
boundary        p p p
atom_style      charge

read_data       ../s0_requench/melt4000.data
mass            1 15.9994
mass            2 28.0855

pair_style      hybrid/overlay buck/coul/long 10.0 lj/cut 1.5
pair_coeff      1 1 buck/coul/long 1388.7730 0.362318 175.0000
pair_coeff      1 2 buck/coul/long 18003.7572 0.205205 133.5381
pair_coeff      2 2 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 1 lj/cut 3.0 1.50 1.50
pair_coeff      1 2 lj/cut 4.0 1.10 1.10
pair_coeff      2 2 lj/cut 0.0 1.0  1.0
kspace_style    pppm 1.0e-4

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.001
variable        Tdamp equal 0.1

compute         myRDF all rdf 200 1 1 1 2 2 2 cutoff 8.0
compute         msd0  all msd
variable        epa   equal pe/atoms

thermo          500
thermo_style    custom step temp press vol density pe v_epa c_msd0[4]

# ================= 1. 4,000 K 재평형 20 ps (7net 본런과 대칭) =================
print "=========== BKS MELT EQUIL 4000 K (NVT, 20 ps) ==========="
velocity        all set 0.0 0.0 0.0
velocity        all create 4000.0 90210 dist gaussian mom yes

reset_timestep  0
fix             1 all nvt temp 4000.0 4000.0 ${Tdamp}
run             20000
unfix           1

print "# T_set(K)  epa(eV/atom)  Press(bar)  MSD(A^2)" file mqbks_${tag}_profile.dat screen no

# ================= 2. quench 4,000 -> 300 K, 100 K x ns step =================
print "=========== BKS QUENCH -> 300 K (NVT, 100 K x ${ns} step) ==========="
variable        Tset equal 4000
variable        nr   equal ${ns}/100

label QLOOP
  reset_timestep 0
  fix           q  all nvt temp ${Tset} ${Tset} ${Tdamp}
  fix           qa all ave/time 100 ${nr} ${ns} v_epa c_thermo_press c_msd0[4]
  run           ${ns}
  print         "${Tset} $(f_qa[1]) $(f_qa[2]) $(f_qa[3])" append mqbks_${tag}_profile.dat screen no
  unfix         qa
  unfix         q
  variable      Tset equal ${Tset}-100
if "${Tset} >= 300" then "jump SELF QLOOP"

# ================= 3. 300 K 평형 5 ps + 생산 5 ps =================
#  7net 본런과 동일 길이로 맞춘다 (통계 조건 일치).
print "=========== BKS EQUIL 300 K (NVT, 5 ps) ==========="
reset_timestep  0
fix             1 all nvt temp 300.0 300.0 ${Tdamp}
run             5000
write_data      equil300_bks_${tag}.data

print "=========== BKS PROD 300 K (NVT, 5 ps, RDF + traj) ==========="
reset_timestep  0
fix             rdfavg all ave/time 10 500 5000 c_myRDF[*] file rdf_bks_${tag}.dat mode vector
dump            trj all custom 20 traj_bks_${tag}.lammpstrj id type xs ys zs
dump_modify     trj sort id
run             5000
undump          trj
unfix           rdfavg
unfix           1

write_data      prod_bks_${tag}.data
print "=========== DONE ${tag} ==========="
