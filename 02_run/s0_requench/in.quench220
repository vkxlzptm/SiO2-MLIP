# S0-requench  BKS melt-quench 재수행 — ρ = 2.20 g/cm³ 고정 NVT
#
# 왜 다시 하는가 (log.lammps 진단 결과):
#   - 원래 런은 승온 100 ps + 4500 K 25 ps 동안 MSD < 1.6 Å² → **녹지 않았다.**
#     그동안의 ρ ≈ 2.2는 초기 결정 부피의 잔상이지 액체 밀도가 아니었다.
#   - step ~130,000에서 비로소 확산 개시(MSD 튐)와 동시에 부피가 2.26 → 2.62로 붕괴.
#   - [정정] 처음에 "비등점 위라서"라고 진단했으나 그 논거는 약하다. 자유표면이 없는 주기셀에서는
#     기포 핵생성 장벽 때문에 과열 액체가 MD 시간척도에서 준안정하게 유지된다.
#     실제로 Erhard et al.(GAP, npj 2022)은 4000 K NPT로 문제없이 돌렸다.
#   - 문헌이 지목하는 진짜 원인 — Dechant, Muralidhar, Ma, J. Phys. Chem. C 130, 7148 (2026):
#       "the presence of unphysical bonds may lead to unphysical cell shape and volume variations
#        if the NPT ensemble is used. ... For these reasons, the NVT ensemble was used for melting
#        simulations, while the NPT ensemble was employed for equilibration runs at 300 K."
#     그리고 용융 온도 권고:
#       "conducting melting simulations at temperatures moderately above the melting point of the
#        crystalline phase - high enough to ensure complete melting but not so high as to introduce
#        excessive thermal fluctuations."
#     우리 런은 **용융 중 NPT** + **4500 K**로 두 가지를 동시에 위반했다.
#
# 이번 설계 (문헌 표준):
#   - **부피 고정 NVT**로 melt-quench. ρ = 2.20 (실험 fused silica, AIMD 참고문헌과 동일).
#     Camellone et al.도 8500 K를 썼지만 NVT 부피 고정이었다. Erhard et al.(GAP)은 NPT지만 4000 K.
#   - **완전 용융을 MSD로 검증**한다. 이게 지난번 실패의 직접 원인.
#   - 출발 구조의 위상은 상관없다(완전히 녹이면 지워짐). 기존 quench 산물을 리스케일해서 쓴다.
#
# 비용: 약 1,240 ps × 557 step/s ≈ 37분 (6랭크)
# 실행: export OMP_NUM_THREADS=1 && mpirun -np 6 lmp_7net -in in.quench220 > quench220.log 2>&1

units           metal
boundary        p p p
atom_style      charge

read_data       ../../01_input/sio2_quenched.data
mass            1 15.9994
mass            2 28.0855

# ---- ρ = 2.20 으로 등방 리스케일 ----
#   질량합 43,260.70 amu → V_target = 71,836.5 / 2.20 = 32,652.95 Å³
#   현재 V = 27,554.315 → 부피비 1.185044 → 선형 스케일 1.185044^(1/3) = 1.058219
variable        s equal 1.058219
change_box      all x scale ${s} y scale ${s} z scale ${s} remap

pair_style      hybrid/overlay buck/coul/long 10.0 lj/cut 1.5
pair_coeff      1 1 buck/coul/long 1388.7730 0.362318 175.0000
pair_coeff      1 2 buck/coul/long 18003.7572 0.205205 133.5381
pair_coeff      2 2 buck/coul/long 0.0 1.0 0.0
pair_coeff      1 1 lj/cut 3.0 1.50 1.50
pair_coeff      1 2 lj/cut 4.0 1.10 1.10
pair_coeff      2 2 lj/cut 0.0 1.0  1.0
kspace_style    pppm 1.0e-4

neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

timestep        0.001
variable        Tdamp equal 0.1

compute         myRDF all rdf 200 1 1 1 2 2 2 cutoff 8.0
compute         msd0 all msd
variable        epa equal pe/atoms

thermo          500
thermo_style    custom step temp press vol density pe v_epa c_msd0[4]

velocity        all create 300.0 77213 dist gaussian mom yes

# ---------------- 1. 승온 300 → 4000 K, 50 ps ----------------
#  부피 고정 + 4000 K: BKS의 Tg(우리 엔탈피 곡선상 ~2500-3000 K)보다 충분히 높되 과하지 않음.
print "=========== HEAT 300 -> 4000 K (NVT, 50 ps) ==========="
fix             1 all nvt temp 300.0 4000.0 ${Tdamp}
run             50000
unfix           1

# ---------------- 2. 4000 K 용융 평형, 200 ps ----------------
#  ★ 검증 게이트: c_msd[4] 가 시간에 선형이고 수십 Å² 이상이어야 완전 용융.
#    지난번 실패는 여기서 MSD < 2 Å² 였는데도 그냥 진행한 것.
print "=========== MELT 4000 K (NVT, 200 ps) — MSD 확인 필수 ==========="
uncompute       msd0
compute         msd0 all msd
thermo_style    custom step temp press vol density pe v_epa c_msd0[4]
fix             1 all nvt temp 4000.0 4000.0 ${Tdamp}
run             200000
unfix           1
write_data      melt4000.data

# ---------------- 3. 단계적 quench 4000 → 300 K ----------------
#  100 K 스텝 × 20 ps = 5×10^12 K/s. 문헌 범위(10^11~10^13 K/s) 안.
print "=========== QUENCH 4000 -> 300 K (NVT, 100 K x 20 ps) ==========="
print "# T_set(K)  PotEng(eV)  epa(eV/atom)  Press(bar)" file quench220_profile.dat screen no
variable        Tset equal 4000
label QLOOP
  reset_timestep 0
  fix           q all nvt temp ${Tset} ${Tset} ${Tdamp}
  fix           qa all ave/time 100 100 20000 v_epa c_thermo_press
  run           20000
  # $(...) 즉시평가 사용 — 지난 vt_profile.dat 에서 변수 간접참조로 중복 라인이 생겼음
  print         "${Tset} $(f_qa[1]) $(f_qa[2])" append quench220_profile.dat screen no
  unfix         qa
  unfix         q
  variable      Tset equal ${Tset}-100
if "${Tset} >= 300" then "jump SELF QLOOP"

# ---------------- 4. 300 K 평형 + RDF, 100 ps ----------------
print "=========== EQUIL 300 K + RDF (NVT, 100 ps) ==========="
reset_timestep  0
fix             1 all nvt temp 300.0 300.0 ${Tdamp}
run             50000
fix             rdfavg all ave/time 10 5000 50000 c_myRDF[*] file rdf_bks220.dat mode vector
run             50000
unfix           rdfavg
unfix           1

write_data      sio2_bks220.data

# ---------------- 5. 300 K NPT 100 ps — BKS의 밀도 '예측' (Dechant 방식) ----------------
#  용융은 NVT로 하고 저온 평형에서만 NPT를 쓰는 것이 문헌 표준.
#  여기서 나오는 밀도가 비로소 "제대로 녹인 BKS 유리의 0 bar 밀도"다.
print "=========== 300 K NPT 0 bar, 100 ps -> BKS density prediction ==========="
thermo_style    custom step temp press vol density pe v_epa
fix             1 all npt temp 300.0 300.0 ${Tdamp} iso 0.0 0.0 1.0
run             100000
unfix           1
write_data      sio2_bks_npt300.data
