  variable      Dm equal f_qavg[2]
  variable      Hm equal f_qavg[3]
  print         "${Tset} ${Vm} ${Dm} ${Hm}" append vt_profile.dat screen no
  unfix         qavg
  unfix         qnpt
  variable      Tset equal ${Tset}-${dT}
  variable      Tset equal 2300-${dT}
  variable      Tset equal 2300-100
if "${Tset} >= ${Tlo}" then "jump SELF QLOOP"
jump SELF QLOOP
  reset_timestep 0                     # 온도마다 step 0 부터: 아래 평균창 계산을 단순화
  fix           qnpt all npt temp ${Tset} ${Tset} ${Tdamp} iso 0.0 0.0 ${Pdamp}
  fix           qnpt all npt temp 2200 ${Tset} ${Tdamp} iso 0.0 0.0 ${Pdamp}
  fix           qnpt all npt temp 2200 2200 ${Tdamp} iso 0.0 0.0 ${Pdamp}
  fix           qnpt all npt temp 2200 2200 0.1 iso 0.0 0.0 ${Pdamp}
  fix           qnpt all npt temp 2200 2200 0.1 iso 0.0 0.0 3
  # Nfreq=Ntot, 창 = Nevery*Nrep = Nprod → run 의 '마지막 Nprod step'만 평균되어
  # 앞의 Nequil(평형 버림 구간)은 자동으로 제외됨
  fix           qavg all ave/time 100 ${Nrep} ${Ntot} v_myvol v_mydens v_myenth
  fix           qavg all ave/time 100 100 ${Ntot} v_myvol v_mydens v_myenth
  fix           qavg all ave/time 100 100 15000 v_myvol v_mydens v_myenth
  run           ${Ntot}
  run           15000
